// CaseEntry 数据模型
// 注意：SQLite 连接器不支持 enum，状态/等级/角色用 String + 应用层 zod 校验

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  passwordHash String
  name         String
  role         String         @default("USER") // USER | ADMIN
  disabled     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  cases        Case[]
  pointRecords PointsLedger[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  cases     Case[]
}

// 案例状态机：
// PENDING_FIRST --初审通过--> PENDING_FINAL --终审定级--> PUBLISHED
// 任一环节可 REJECTED（rejectedStage 记录驳回环节，重交回到被驳环节）
model Case {
  id              String    @id @default(cuid())
  title           String
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  authorId        String
  author          User      @relation(fields: [authorId], references: [id])
  status          String    @default("PENDING_FIRST") // PENDING_FIRST | PENDING_FINAL | PUBLISHED | REJECTED
  rejectedStage   String? // FIRST | FINAL（status=REJECTED 时有值）
  rejectReason    String?
  grade           String? // A | B | C（终审定级）
  firstReviewerId String?
  firstReviewAt   DateTime?
  finalReviewerId String?
  finalReviewAt   DateTime?
  fileName        String // 附件原始文件名
  filePath        String // uploads/ 下相对路径
  fileType        String // 扩展名（小写，含点）
  fileSize        Int // 字节
  submittedAt     DateTime  @default(now())
  publishedAt     DateTime?
  updatedAt       DateTime  @updatedAt
  pointRecords    PointsLedger[]

  @@index([status])
  @@index([authorId])
  @@index([categoryId])
  @@index([publishedAt])
}

// 积分流水：每笔积分记录 谁/哪案例/何事件/多少分/何时
// (caseId, eventType) 唯一 —— 提交、初审通过、定级入库每案例各只发一次
model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  eventType String // SUBMIT | FIRST_PASS | FINAL_GRADE
  points    Int
  createdAt DateTime @default(now())

  @@unique([caseId, eventType])
  @@index([userId, createdAt])
}

// 积分规则配置（admin 后台可调）
model PointsConfig {
  key   String @id // SUBMIT | FIRST_PASS | GRADE_A | GRADE_B | GRADE_C
  value Int
}
